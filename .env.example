# Environment
NODE_ENV=             # "development" | "production" | "test" (defines the app mode)
BASE_URL=             # Backend API base URL (e.g., https://api.example.com)

# NextAuth (Authentication in Next.js)
NEXTAUTH_URL=         # Your app’s frontend URL (e.g., http://localhost:3000 for dev, https://example.com for prod)
NEXTAUTH_SECRET=      # A long random string (generate with: openssl rand -base64 32 OR `npx auth secret`)

# Stripe (Payments)
STRIPE_PUBLISHABLE_KEY=  # From Stripe Dashboard > Developers > API keys (Publishable key)

# PayPal (Payments)
PAYPAL_CLIENT_ID=        # From PayPal Developer Dashboard > My Apps & Credentials (Sandbox/Live App)
